ActiveThorns = "
  ADMBaseX
  CarpetX
  FlowTracerX
  HydroBaseX
  IOUtil
  ODESolvers
  TestFlowTracerX
"

Cactus::presync_mode = "mixed-error"
Cactus::cctk_itlast = 4

CarpetX::xmin = -1.0
CarpetX::ymin = -1.0
CarpetX::zmin = -1.0
CarpetX::xmax = 1.0
CarpetX::ymax = 1.0
CarpetX::zmax = 1.0
CarpetX::ncells_x = 16
CarpetX::ncells_y = 16
CarpetX::ncells_z = 16
CarpetX::blocking_factor_x = 1
CarpetX::blocking_factor_y = 1
CarpetX::blocking_factor_z = 1
CarpetX::ghost_size = 2
CarpetX::dtfac = 0.25

Driver::periodic = yes
Driver::periodic_x = yes
Driver::periodic_y = yes
Driver::periodic_z = yes

ODESolvers::method = "IMEX42L"

FlowTracerX::active = yes
FlowTracerX::sample_variables = ""
FlowTracerX::num_tracer_sets = 1
FlowTracerX::tracer_name[0] = "imex42l_lattice"
FlowTracerX::seed_type[0] = "lattice"
FlowTracerX::lattice_nx[0] = 4
FlowTracerX::lattice_ny[0] = 4
FlowTracerX::lattice_nz[0] = 4
FlowTracerX::seed_box_size_x[0] = 1.0
FlowTracerX::seed_box_size_y[0] = 1.0
FlowTracerX::seed_box_size_z[0] = 1.0

TestFlowTracerX::test_velocity[0] = 0.25
TestFlowTracerX::test_velocity[1] = -0.10
TestFlowTracerX::test_velocity[2] = 0.05
TestFlowTracerX::test_lapse = 0.8
TestFlowTracerX::test_shift[0] = 0.05
TestFlowTracerX::test_shift[1] = -0.02
TestFlowTracerX::test_shift[2] = 0.01
TestFlowTracerX::expected_particles = 64
TestFlowTracerX::check_linear_mean_position = yes
TestFlowTracerX::expected_coordinate_velocity[0] = 0.15
TestFlowTracerX::expected_coordinate_velocity[1] = -0.06
TestFlowTracerX::expected_coordinate_velocity[2] = 0.03
TestFlowTracerX::position_tolerance = 1.0e-12

IO::parfile_write = no
