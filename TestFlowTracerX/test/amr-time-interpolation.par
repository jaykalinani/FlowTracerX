ActiveThorns = "
  ADMBaseX
  BoxInBox
  CarpetX
  CarpetXRegrid
  FlowTracerX
  HydroBaseX
  IOUtil
  ODESolvers
  Subcycling
  TestFlowTracerX
"

Cactus::presync_mode = "mixed-error"
Cactus::cctk_itlast = 4

CarpetX::xmin = -1.0
CarpetX::ymin = -1.0
CarpetX::zmin = -1.0
CarpetX::xmax = 1.0
CarpetX::ymax = 1.0
CarpetX::zmax = 1.0
CarpetX::ncells_x = 16
CarpetX::ncells_y = 16
CarpetX::ncells_z = 16
CarpetX::blocking_factor_x = 1
CarpetX::blocking_factor_y = 1
CarpetX::blocking_factor_z = 1
CarpetX::max_grid_size_x = 8
CarpetX::max_grid_size_y = 8
CarpetX::max_grid_size_z = 8
CarpetX::max_num_levels = 2
CarpetX::ghost_size = 3
CarpetX::dtfac = 0.25
CarpetX::prolongation_type = "ddf"
CarpetX::use_subcycling = yes
CarpetX::restrict_during_sync = no

Driver::periodic = yes
Driver::periodic_x = yes
Driver::periodic_y = yes
Driver::periodic_z = yes
Driver::regrid_every = 1

BoxInBox::num_regions = 1
BoxInBox::shape_1 = "cube"
BoxInBox::num_levels_1 = 2
BoxInBox::radius_1[1] = 0.5

ODESolvers::method = "SSPRK3"

FlowTracerX::active = yes
FlowTracerX::sample_variables = ""
FlowTracerX::subcycling_guard_cells = 1
FlowTracerX::max_num_cells_moved = 8
FlowTracerX::num_tracer_sets = 1
FlowTracerX::tracer_name[0] = "amr_time_crossing"
FlowTracerX::seed_type[0] = "lattice"
FlowTracerX::lattice_nx[0] = 16
FlowTracerX::lattice_ny[0] = 4
FlowTracerX::lattice_nz[0] = 4
FlowTracerX::seed_box_size_x[0] = 1.4
FlowTracerX::seed_box_size_y[0] = 0.5
FlowTracerX::seed_box_size_z[0] = 0.5

# The velocity is reconstructed from an evolved scalar with a constant RHS.
# Fine-level particles cross the static refinement boundary while the coarse
# level is at an intermediate time. The quadratic mean trajectory therefore
# checks CarpetX time interpolation as well as particle ownership and level dt.
TestFlowTracerX::test_velocity[0] = 0.4
TestFlowTracerX::test_velocity[1] = 0.02
TestFlowTracerX::test_velocity[2] = -0.03
TestFlowTracerX::test_velocity_x_time_derivative = 0.8
TestFlowTracerX::expected_particles = 256
TestFlowTracerX::check_quadratic_mean_position = yes
TestFlowTracerX::initial_mean_position[0] = 0.0
TestFlowTracerX::initial_mean_position[1] = 0.0
TestFlowTracerX::initial_mean_position[2] = 0.0
TestFlowTracerX::expected_coordinate_velocity[0] = 0.4
TestFlowTracerX::expected_coordinate_velocity[1] = 0.02
TestFlowTracerX::expected_coordinate_velocity[2] = -0.03
TestFlowTracerX::expected_coordinate_acceleration[0] = 0.8
TestFlowTracerX::expected_coordinate_acceleration[1] = 0.0
TestFlowTracerX::expected_coordinate_acceleration[2] = 0.0
TestFlowTracerX::position_tolerance = 1.0e-11

IO::out_dir = $parfile
IO::out_every = 1
IO::parfile_write = no
CarpetX::out_metadata = no
CarpetX::out_norm_vars = "TestFlowTracerX::mask"
CarpetX::out_norm_omit_unstable = yes
CarpetX::out_tsv_vars = " "
