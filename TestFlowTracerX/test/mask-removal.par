ActiveThorns = "
  ADMBaseX
  CarpetX
  FlowTracerX
  HydroBaseX
  IOUtil
  ODESolvers
  TestFlowTracerX
"

Cactus::presync_mode = "mixed-error"
Cactus::cctk_itlast = 1

CarpetX::xmin = -1.0
CarpetX::ymin = -1.0
CarpetX::zmin = -1.0
CarpetX::xmax = 1.0
CarpetX::ymax = 1.0
CarpetX::zmax = 1.0
CarpetX::ncells_x = 16
CarpetX::ncells_y = 16
CarpetX::ncells_z = 16
CarpetX::blocking_factor_x = 1
CarpetX::blocking_factor_y = 1
CarpetX::blocking_factor_z = 1
CarpetX::ghost_size = 2
CarpetX::dtfac = 0.25

Driver::periodic = "yes"
Driver::periodic_x = yes
Driver::periodic_y = yes
Driver::periodic_z = yes

ODESolvers::method = "RK4"

FlowTracerX::active = yes
FlowTracerX::sample_variables = ""
FlowTracerX::destroy_mask_var = "TestFlowTracerX::mask"
FlowTracerX::destroy_mask_comparison = "below"
FlowTracerX::destroy_mask_value = 0.5
FlowTracerX::num_tracer_sets = 1
FlowTracerX::tracer_name[0] = "masked"
FlowTracerX::seed_type[0] = "lattice"
FlowTracerX::lattice_nx[0] = 3
FlowTracerX::lattice_ny[0] = 3
FlowTracerX::lattice_nz[0] = 3
FlowTracerX::seed_box_size_x[0] = 0.2
FlowTracerX::seed_box_size_y[0] = 0.2
FlowTracerX::seed_box_size_z[0] = 0.2

TestFlowTracerX::mask_radius = 0.5
TestFlowTracerX::expected_particles = 0

IO::parfile_write = "no"
